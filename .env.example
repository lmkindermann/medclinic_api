# Porta da API
PORT=3333

# Segredo usado para assinar/validar o Token JWT
# Em produção, use um valor longo, aleatório e secreto (nunca versionar!)
# Gere uma chave aleatória forte para o ambiente local ou de produção.
JWT_SECRET=substitua_por_uma_chave_secreta_forte
JWT_EXPIRES_IN=1d

# Configurando as origens permitidas para requisições CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting global
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Rate Limiting para autenticação
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------
# Conexão com o Postgres na Aiven
# Pegue esses dados no painel do serviço Aiven (Service overview)
# ------------------------------------------------------------------
#DB_HOST=host_do_seu_banco_aiven.aivencloud.com
#DB_PORT=porta_do_seu_banco_aiven
#DB_USERNAME=seu_usuario_aiven
#DB_PASSWORD=sua_senha_aiven
#DB_DATABASE=defaultdb

# A Aiven exige SSL. Deixe "true" para habilitar.
#DB_SSL=true

# ------------------------------------------------------------------
# Opção 2 - Conexão com o Postgres no pgAdmin4 local
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=seu_usuario_local
DB_PASSWORD=sua_senha_local
DB_DATABASE=medclinic_db
DB_SSL=false

# ------------------------------------------------------------------
# Configurações do administrador inicial
# ------------------------------------------------------------------
# Esses dados são utilizados pelo script de criação do administrador 
# A senha deve ser alterada.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@medclinic.com
ADMIN_PASSWORD=DefinaUmaSenhaForteAqui123!

# Nível de log: error, warn, info, http ou debug
LOG_LEVEL=info